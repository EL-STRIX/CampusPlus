{
  "name": "campusplus-backend",
  "version": "1.0.0",
  "description": "CampusPlus API - Backend service",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "postinstall": "prisma generate",
    "test": "jest --runInBand && node prisma/seedReports.js",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed:dev": "node src/db/seeds/dev.seed.js",
    "seed:admin": "node src/db/seeds/admin.seed.js",
    "seed:reference": "node src/db/seeds/reference.seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@sentry/node": "^8.26.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.18.0",
    "supertest": "^7.0.0"
  }
}
